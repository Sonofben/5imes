# Public URL of the app (no trailing slash). For the demo: https://<your-ip-with-dashes>.sslip.io
NEXT_PUBLIC_SITE_URL=https://example.sslip.io

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose. Used for staff invite emails and the Paystack webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Kora Forge account). Leave the secret empty to run billing in demo mode.
PAYSTACK_SECRET_KEY=
# Subaccount code (ACCT_xxxx) that payments are routed to
PAYSTACK_SUBACCOUNT=
