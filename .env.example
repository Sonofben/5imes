# Public app URL (no trailing slash); used by payment callbacks and redirects
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public client key: legacy anon JWT or a Supabase sb_publishable_ key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose or commit. Used for private ledgers and trusted RPC calls.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — enable after your merchant onboarding and compliance are complete
# Server only — never expose or commit a live secret key. Transactions settle to this merchant account.
PAYSTACK_SECRET_KEY=

# Optional: Paystack subaccount code (ACCT_xxxx) that payments are routed to. Leave empty to settle to the main account.
PAYSTACK_SUBACCOUNT=
