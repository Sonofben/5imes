# Public app URL (no trailing slash); used by payment callbacks and redirects
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public client key: legacy anon JWT or a Supabase sb_publishable_ key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose or commit. Used for private ledgers and trusted RPC calls.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — enable after your merchant onboarding and compliance are complete
# Server only — never expose or commit a live secret key. Transactions settle to this merchant account.
PAYSTACK_SECRET_KEY=

# Optional: Paystack subaccount code (ACCT_xxxx) that payments are routed to. Leave empty to settle to the main account.
PAYSTACK_SUBACCOUNT=

# Optional: bank-transfer payments (works without a payment gateway). When the account number
# is set, admins see these details on the Billing page. Record received transfers with
# record_bank_transfer(...) in the Supabase SQL Editor (see supabase/migrations/0006_bank_transfer.sql).
BANK_TRANSFER_BANK=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
# Where admins send the transfer receipt, e.g. billing@yourdomain or a WhatsApp number
BANK_TRANSFER_CONTACT=
