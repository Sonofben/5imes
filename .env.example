# Public app URL (no trailing slash); used by payment callbacks and redirects
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public client key: legacy anon JWT or a Supabase sb_publishable_ key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose or commit. Used for private ledgers and trusted RPC calls.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — enable after your merchant onboarding and compliance are complete
# Server only — never expose or commit a live secret key. Transactions settle to this merchant account.
PAYSTACK_SECRET_KEY=

# Optional: Paystack subaccount code (ACCT_xxxx) that payments are routed to. Leave empty to settle to the main account.
PAYSTACK_SUBACCOUNT=


# Moniepoint online payments (Monnify). From the Monnify dashboard → Developer / Settings → API Keys & Contracts.
# Use https://sandbox.monnify.com with sandbox keys to test; https://api.monnify.com for live.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Cloudflare Turnstile (CAPTCHA) — the SITE key only. It is public and baked into the page at build time.
# The SECRET key goes in Supabase → Authentication → Attack Protection, never here.
# Leave empty until CAPTCHA protection is switched on in Supabase (both must change together).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: error tracking (GlitchTip or Sentry) DSN, e.g. https://abc123@glitchtip.example.com/1
ERROR_TRACKING_DSN=

# Optional: secret for signing on-screen messages in links. Defaults to a key derived from
# SUPABASE_SERVICE_ROLE_KEY, so you only need this if you want them independent.
FLASH_SECRET=

# Visitor emails (invitations with QR pass, host alerts) — sent with Resend's API.
# Use the same Resend account as Supabase's SMTP; EMAIL_FROM must be on a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=5imes <no-reply@5imes.click>

# Staging copy only (DEPLOY.md §14). Leave all of these out on the live server.
# APP_ENV=staging
# COMPOSE_PROJECT_NAME=fivetime-staging
# CONTAINER_NAME=fivetime-staging-web
# IMAGE_NAME=fivetime-staging-web
# APP_PORT=3006
